+	void torrent::recordWebSeedRedirect(web_seed_t& source, web_seed_t& target
+		, file_index_t const file, std::map<std::string, std::uint64_t> const& origins)
+	{
+		TORRENT_ASSERT(is_single_thread());
+		if (!source.ephemeral) source.redirectGenerations.erase(file);
+		if (&source == &target || !target.ephemeral || target.removed
+			|| target.disabled || target.peer_info.banned || source.removed
+			|| source.disabled || source.peer_info.banned) return;
+
+		auto const previousOrigins = target.redirectOrigins[file];
+		auto disconnectChangedTarget = [&]
+		{
+			if (previousOrigins.empty() || previousOrigins == target.redirectOrigins[file]
+				|| target.peer_info.connection == nullptr) return;
+			// Do not let queued responses for older lineage invalidate a fresh target.
+			auto* peer = static_cast<peer_connection*>(target.peer_info.connection);
+			peer->disconnect(errors::redirecting, operation_t::bittorrent
+				, peer_connection_interface::normal);
+		};
+
+		if (!source.ephemeral)
+		{
+			auto const generation = ++m_webSeedRedirectGeneration;
+			source.redirectGenerations[file] = generation;
+			target.redirectOrigins[file][source.url] = generation;
+			disconnectChangedTarget();
+			return;
+		}
+
+		for (auto const& origin : origins)
+		{
+			auto const root = std::find_if(m_web_seeds.begin(), m_web_seeds.end()
+				, [&origin](web_seed_t const& seed)
+				{ return !seed.ephemeral && seed.type == web_seed_entry::url_seed
+					&& seed.url == origin.first; });
+			if (root == m_web_seeds.end() || root->removed || root->disabled
+				|| root->peer_info.banned) continue;
+			auto const generation = root->redirectGenerations.find(file);
+			if (generation == root->redirectGenerations.end()
+				|| generation->second != origin.second) continue;
+			target.redirectOrigins[file][origin.first] = origin.second;
+		}
+		disconnectChangedTarget();
+	}
+
+	void torrent::retryWebSeedOrigins(web_seed_t const& target, file_index_t const file
+		, std::map<std::string, std::uint64_t> const& origins)
+	{
+		TORRENT_ASSERT(is_single_thread());
+		if (!target.ephemeral || target.removed || target.disabled
+			|| target.peer_info.banned) return;
+
+		// Keep the native retry floor even when Retry-After is shorter.
+		auto const retry = std::max(target.retry, aux::time_now32()
+			+ seconds32(settings().get_int(settings_pack::urlseed_wait_retry)));
+		for (auto const& origin : origins)
+		{
+			auto const root = std::find_if(m_web_seeds.begin(), m_web_seeds.end()
+				, [&origin](web_seed_t const& seed)
+				{ return !seed.ephemeral && seed.type == web_seed_entry::url_seed
+					&& seed.url == origin.first; });
+			if (root == m_web_seeds.end() || root->removed || root->disabled
+				|| root->peer_info.banned || root->have_files.empty()
+				|| root->have_files.get_bit(file)) continue;
+			auto const generation = root->redirectGenerations.find(file);
+			if (generation == root->redirectGenerations.end()
+				|| generation->second != origin.second) continue;
+
+			// Consume this delegation before allowing another origin request.
+			// Old responses cannot revive a newer delegation or a direct failure.
+			root->redirectGenerations.erase(generation);
+			root->have_files.set_bit(file);
+			root->interesting = true;
+			root->retry = std::max(root->retry, retry);
+			if (root->peer_info.connection != nullptr)
+			{
+				// A multi-file origin may still be serving another file. Reconnect
+				// after the delay so its restored availability is advertised.
+				auto* peer = static_cast<peer_connection*>(root->peer_info.connection);
+				peer->disconnect(errors::redirecting, operation_t::bittorrent
+					, peer_connection_interface::normal);
+			}
+		}
+		update_want_tick();
+	}
+
